# AIC8800 USB adapters enumerate as a fake mass storage device ("Aic MSC") first.
# Ejecting it makes the adapter re-enumerate in Wi-Fi mode, where the driver binds.
SUBSYSTEM=="block", ACTION=="add", KERNEL=="sd*", ENV{DEVTYPE}=="disk", ATTRS{idVendor}=="a69c", ATTRS{idProduct}=="5721|5723|5725", RUN+="/usr/bin/eject /dev/%k"
